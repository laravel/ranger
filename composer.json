{
    "name": "laravel/ranger",
    "description": "Laravel Ranger is a powerful introspection library for Laravel applications.",
    "keywords": [
        "laravel"
    ],
    "homepage": "https://github.com/laravel/ranger",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/laravel/ranger/issues",
        "source": "https://github.com/laravel/ranger"
    },
    "authors": [
        {
            "name": "Taylor Otwell",
            "email": "taylor@laravel.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/broadcasting": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/routing": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/validation": "^12.0|^13.0",
        "laravel/serializable-closure": "^2.0",
        "laravel/surveyor": "^0.3.0",
        "spatie/php-structure-discoverer": "^2.3",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "inertiajs/inertia-laravel": "^2.0",
        "laravel/pint": "^1.22",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0",
        "phpstan/phpstan": "2.1.24"
    },
    "autoload": {
        "psr-4": {
            "Laravel\\Ranger\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\": "workbench/app/",
            "Laravel\\Ranger\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.x-dev"
        },
        "laravel": {
            "providers": [
                "Laravel\\Ranger\\RangerServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
